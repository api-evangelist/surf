          "name": "Crypto News Feed",
          "request": {
            "name": "Crypto News Feed",
            "description": {
              "content": "Returns crypto news from major sources.\n\n**Filters:** `source` (enum), `project`, and time range (`from`/`to`).\n\n**Sort:** `recency` (default) or `trending`.\n\nUse the detail endpoint with article `id` for full content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "gateway",
                "v1",
                "news",
                "feed"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "source",
                  "value": "<string>",
                  "description": "Filter by news source"
                },
                {
                  "disabled": false,
                  "key": "project",
                  "value": "<string>",
                  "description": "Comma-separated project names to filter by"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "Filter articles published on or after this time. Accepts Unix seconds or date string (2024-01-01)"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "Filter articles published on or before this time. Accepts Unix seconds or date string (2024-02-01)"
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "recency",
                  "description": "Sort order: recency (newest first) or trending (deterministic newest-first alias until engagement ranking is available)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Results per page (max 50)"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset"
                }
              ],
              "variable": []
            },
            "header": [
