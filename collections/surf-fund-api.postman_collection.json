          "name": "Fund Profile Detail",
          "request": {
            "name": "Fund Profile Detail",
            "description": {
              "content": "Returns a crypto VC fund's full profile: description, jurisdiction, portfolio count, social links, and team members with roles.\n\n**Included fields:** X accounts, team members, recent research, invested project count.\n\nThis does NOT return the list of investments — use `/fund/portfolio` for that.\n\n**Lookup:** by UUID (`id`) or name (`q`). Returns 404 if not found.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "gateway",
                "v1",
                "fund",
                "detail"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "Surf fund UUID. PREFERRED — always use this when available from a previous response (e.g. id from /search/fund). Takes priority over q."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Fuzzy fund name search. Only use when 'id' is not available. May return unexpected results for ambiguous names."
                }
              ],
              "variable": []
